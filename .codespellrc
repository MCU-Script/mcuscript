#
# The other MCUHome repositories keep this block in their pyproject.toml.
# This repository has no project file — the implementation language is
# undecided — so the configuration lives in its own file.

[codespell]
# German words inside verbatim product-owner quotes in docs/adr/ (the
# roadmap and glossary are German documents; the quotes must stay
# verbatim). "als" reads as "also", "sie" as "size" to an English
# spellchecker.
ignore-words-list = als,sie

# The Contributor Covenant 3.0, reproduced verbatim. Its wording is the
# licensed text (CC-BY-SA-4.0, see REUSE.toml) — "correcting" it would
# make the file no longer the Covenant. Both spellings of the path:
# pre-commit hands the hook a bare relative path, a manual `codespell .`
# produces a "./" prefix, and skip patterns match the string as given.
skip = ./CODE_OF_CONDUCT.md,CODE_OF_CONDUCT.md
