#
# The MCUHome repositories keep this block in their pyproject.toml. This
# repository has no project file — the implementation language is
# undecided — so the configuration lives in its own file.
#
# The ignore list is kept to real vocabulary. The design conversation
# this project inherits was German, and the first draft of the ADRs
# quoted it verbatim, which would have meant teaching the spellchecker
# to ignore German words that are also plausible English typos ("ist",
# "oder"). The quotes are translated instead; one German sentence
# remains, and it trips nothing.

[codespell]
# Rust's word for a package. Reading it as "create" is the one false
# positive this repository produces.
ignore-words-list = crate
# The Contributor Covenant 3.0, reproduced verbatim. Its wording is the
# licensed text (CC-BY-SA-4.0, see REUSE.toml) — "correcting" it would
# make the file no longer the Covenant. Both spellings of the path:
# pre-commit hands the hook a bare relative path, a manual `codespell .`
# produces a "./" prefix, and skip patterns match the string as given.
skip = ./CODE_OF_CONDUCT.md,CODE_OF_CONDUCT.md
